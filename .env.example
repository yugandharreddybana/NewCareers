# =============================================================
# CareerOps — Local Development Environment Variables
# Copy this file to .env and fill in every value.
# Never commit .env to git (it is already in .gitignore).
# =============================================================

# ── Supabase PostgreSQL ───────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection String (URI)
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password

# ── JWT RSA Keypair ──────────────────────────────────────────
# Generate locally:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM content (including -----BEGIN/END----- lines)
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Supabase Storage & Auth ───────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── NVIDIA NIM (PRIMARY AI ENGINE) ───────────────────────────
# Free tier available. Get from: https://build.nvidia.com
# Click any model → "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here

# ── Adzuna Job Source ────────────────────────────────────────
# Free. Register at: https://developer.adzuna.com
# Create an app → copy App ID and App Key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# ── Reed.co.uk Job Source ─────────────────────────────────────
# Free. Register at: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=your-reed-api-key

# ── SerpAPI (used inside AI skills for web search) ────────────
# Free tier: 100 searches/month. Get from: https://serpapi.com
SERPAPI_API_KEY=your-serpapi-key

# ── Supabase Storage (CV / resume uploads) ───────────────────
# Required for CV file download; optional in local dev (parsed text still saved).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Google Sign-In (OAuth 2.0) ───────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:5173 (and your production URL)
# Same Client ID in frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Resend Email ──────────────────────────────────────────────
# Free tier: 100 emails/day. Get from: https://resend.com
RESEND_API_KEY=re_...

# ── Internal Trust (for admin endpoints) ─────────────────────
# Any strong random string — used as a shared secret for X-Internal-Secret header
# Must match middleware/.env and Java internal.trust.secret (see application-test.properties)
INTERNAL_TRUST_SECRET=test-internal-trust-secret-minimum-32-characters-long

# ── Admin User IDs ────────────────────────────────────────────
# Comma-separated UUIDs of users who can access /admin/**
# Get your userId from the users table after registering once
APP_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# ── App Base URL ──────────────────────────────────────────────
APP_BASE_URL=http://localhost:4000

# ── Spring Profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── GitHub Prompt Fork (skill prompts — Layer 2 before classpath bundle) ──
# Default fork: yugandharreddybana/career-ops-plugin (sync via scripts/sync-career-ops-plugin.ps1)
GITHUB_FORK_OWNER=yugandharreddybana
GITHUB_FORK_REPO=career-ops-plugin

# ── NVIDIA / onboarding delivery (optional overrides) ───────
# NVIDIA_MAX_CONCURRENT=2
# JOBS_ONBOARDING_HEURISTIC_FALLBACK=true

# ── Deprecated (kept for rollback only — not needed locally) ─
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
