# =============================================================
# CareerOps — Local Development Environment Variables
# Copy this file to .env and fill in every value.
# Never commit .env to git (it is already in .gitignore).
# =============================================================

# ── Required secrets (set in gitignored .env — never commit values) ──
# Generate: APP_MASTER_KEK / APP_ENCRYPTION_KEY → openssl rand -base64 32
#           APP_INTERNAL_SECRET → openssl rand -hex 32
#           JWT PEMs → openssl genrsa 2048; pkcs8 + pubout (see JWT section below)
APP_ENCRYPTION_KEY=          # 256-bit AES key, base64
APP_MASTER_KEK=              # 256-bit master key encryption key, base64
JWT_PRIVATE_KEY_PEM=         # RSA 2048-bit private key PEM
JWT_PUBLIC_KEY_PEM=          # RSA 2048-bit public key PEM
APP_INTERNAL_SECRET=         # HMAC secret for internal service calls

# ── Supabase PostgreSQL ───────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection String (URI)
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password

# ── JWT RSA Keypair (RS256, 2048-bit minimum) ───────────────
# Set JWT_PRIVATE_KEY_PEM / JWT_PUBLIC_KEY_PEM in Required secrets above.
# Generate locally:
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in private.pem -out private-pkcs8.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste full PEM (including -----BEGIN/END----- lines). PKCS#8 private preferred.
# Legacy aliases (optional — middleware may read these)
JWT_PRIVATE_KEY=${JWT_PRIVATE_KEY_PEM}
JWT_PUBLIC_KEY=${JWT_PUBLIC_KEY_PEM}

# ── Supabase Storage & Auth ───────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── NVIDIA NIM (PRIMARY AI ENGINE) ───────────────────────────
# Free tier available. Get from: https://build.nvidia.com
# Click any model → "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-from-build.nvidia.com
# Optional — defaults to meta/llama-3.3-70b-instruct (required for Tailor CV + all AI skills)
NVIDIA_AGENT_MODEL=meta/llama-3.3-70b-instruct

# ── Adzuna Job Source ────────────────────────────────────────
# Free. Register at: https://developer.adzuna.com
# Create an app → copy App ID and App Key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# ── Reed.co.uk Job Source ─────────────────────────────────────
# Free. Register at: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=your-reed-api-key

# ── SerpAPI (used inside AI skills for web search) ────────────
# Free tier: 100 searches/month. Get from: https://serpapi.com
SERPAPI_API_KEY=your-serpapi-key

# ── Playwright scraper (auto-started with backend — no manual step) ─
# Optional: docker compose up -d scraper  →  SCRAPER_BASE_URL=http://127.0.0.1:5500 SCRAPER_AUTO_START=false
# One-time setup: cd scraper && pip install -r requirements.txt && playwright install chromium
SCRAPER_BASE_URL=http://127.0.0.1:5500
SCRAPER_AUTO_START=true

# ── Supabase Storage (CV / resume uploads) ───────────────────
# Required for CV file download; optional in local dev (parsed text still saved).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Login word CAPTCHA (jumbled characters on /login) ────────
# Off in local dev (default). Set true in production deploy env.
# AUTH_LOGIN_WORD_CAPTCHA_REQUIRED=true

# ── reCAPTCHA v2 (onboarding email verify) ───────────────────
# Create at: https://www.google.com/recaptcha/admin (type: "I'm not a robot" Checkbox)
# Add domain: localhost (and production hostname)
# Site key → frontend/.env.local as VITE_RECAPTCHA_SITE_KEY
# Secret key → repo .env as captcha.secret (below)
captcha.secret=

# ── Google Sign-In (OAuth 2.0) ───────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:5173 (and your production URL)
# Same Client ID in frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Resend Email ──────────────────────────────────────────────
# Free tier: 100 emails/day. Get from: https://resend.com
RESEND_API_KEY=re_...

# ── Internal HMAC (middleware → Java) ─────────────────────────
# Set APP_INTERNAL_SECRET in Required secrets above (must match middleware/.env).
# Deprecated middleware alias — use APP_INTERNAL_SECRET in middleware/.env instead
# INTERNAL_TRUST_SECRET=

# ── Admin User IDs ────────────────────────────────────────────
# Comma-separated UUIDs of users who can access /admin/**
# Get your userId from the users table after registering once
APP_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# ── App Base URL ──────────────────────────────────────────────
APP_BASE_URL=http://localhost:4000

# ── Spring Profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── GitHub Prompt Fork (skill prompts — Layer 2 before classpath bundle) ──
# Default fork: yugandharreddybana/career-ops-plugin (sync via scripts/sync-career-ops-plugin.ps1)
GITHUB_FORK_OWNER=yugandharreddybana
GITHUB_FORK_REPO=career-ops-plugin

# ── NVIDIA / onboarding delivery (optional overrides) ───────
# NVIDIA_MAX_CONCURRENT=2
# JOBS_ONBOARDING_HEURISTIC_FALLBACK=true

# ── Deprecated (kept for rollback only — not needed locally) ─
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
