# =============================================================================
# NewCareers / CareerOps — Environment Variables Template
# =============================================================================
# Copy this file to the appropriate .env location and fill in real values.
# NEVER commit .env files with real secrets.
#
#   Frontend  → frontend/.env
#   Middleware → middleware/.env
#   Backend   → backend/src/main/resources/application.properties
# =============================================================================

# ---- FRONTEND (frontend/.env) -----------------------------------------------

# Base URL of the Node.js middleware
VITE_API_URL=http://localhost:4000

# Set to 'true' ONLY to skip auth guards during local development.
# DO NOT set this in staging or production.
VITE_DEV_BYPASS_GUARDS=false

# Set to 'true' to use local mock API responses instead of hitting the backend.
VITE_USE_MOCKS=false

# ---- MIDDLEWARE (middleware/.env) -------------------------------------------

# Port the Express middleware listens on
PORT=4000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Java Spring backend base URL (middleware proxies requests here)
JAVA_BACKEND_URL=http://localhost:8080

# Base64-encoded SPKI public key used by middleware to verify Java RS256 JWTs.
JWT_PUBLIC_

# Trust secret propagated from middleware to backend protected routes.
INTERNAL_TRUST_HEADER=X-Internal-User-Id
INTERNAL_TRUST_SECRET=dev-internal-trust-secret-minimum-32-characters-long

# Node environment (development | production)
NODE_ENV=development

# ---- STRIPE (middleware/.env) -----------------------------------------------

# Stripe secret key (starts with sk_test_ for test mode)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe webhook signing secret (from Stripe Dashboard > Webhooks)
# For local testing, use: stripe listen --forward-to localhost:4000/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- JAVA BACKEND (application.properties) ----------------------------------

# Database connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careerops
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_ME

# Redis (required in production for shared rate limiting)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JWT
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PKCS8_PRIVATE_KEY
JWT_PUBLIC_

# Mail (for password reset emails)
spring.mail.host=smtp.example.com
spring.mail.port=587
spring.mail.username=REPLACE_ME
spring.mail.password=REPLACE_ME
