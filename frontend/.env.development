# ─── Local development (Vite MODE=development) ───────────────────────────────
# Leave VITE_API_URL unset → Vite proxies /api to middleware :4000
# VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=
VITE_STRIPE_PUBLIC_KEY=pk_test_
# Auth route guards always require a real login — do not bypass in ProtectedRoute.
# When true, only shows the dev banner and skips ensureFreshSession() token checks.
VITE_DEV_BYPASS_GUARDS=false
