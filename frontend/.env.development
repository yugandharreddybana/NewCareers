# ─── Dev Route Guard Bypass ────────────────────────────────────────────────────
# Setting this to "true" disables all auth + onboarding guards so you can
# freely navigate every page while building the UI without needing a real
# login session.
#
# To re-enable guards locally (to test the auth flow), set to "false".
# This file is gitignored in production deployments — never committed to a
# live environment.
VITE_DEV_BYPASS_GUARDS=true
