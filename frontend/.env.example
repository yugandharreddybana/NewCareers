# ─── Required: API base URL ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── Dev Route Guard Bypass ────────────────────────────────────────────────────
# Set to "true" ONLY in .env.development to skip login/onboarding guards.
# Leave unset or set to "false" in production.
VITE_DEV_BYPASS_GUARDS=true
