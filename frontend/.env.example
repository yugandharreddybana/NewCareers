# ─────────────────────────────────────────────────────────────────────────────
# CareerOps Frontend — copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# Only VITE_ prefixed vars are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# The frontend MUST talk to the Node middleware — never Java directly.
# Leave VITE_API_URL unset during `vite dev` to use the built-in `/api` proxy
# to the middleware on port 4000 without browser CORS preflights.
# For `vite preview` or a frontend hosted on a different origin than the API:
# VITE_API_URL=https://api.yourdomain.com
#
# Do NOT set VITE_API_URL=http://localhost:4000 for `npm run dev` — that skips
# the Vite proxy and causes ERR_CONNECTION_REFUSED if middleware is not up.
# Use `npm run dev:stack` to run Vite + middleware together.

# Google Sign-In — OAuth 2.0 Web client ID (must match GOOGLE_OAUTH_CLIENT_ID on Java)
# Google Cloud Console → Credentials → Authorized JavaScript origins: http://localhost:5173
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# reCAPTCHA v2 site key (must pair with captcha.secret in repo root .env)
# Create at: https://www.google.com/recaptcha/admin — type: "I'm not a robot" Checkbox
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ── Stripe (public publishable key only — never secret key) ───────────────────
# VITE_STRIPE_PUBLIC_KEY=pk_test_...   (dev/staging)
# VITE_STRIPE_PUBLIC_KEY=pk_live_...   (production CI build)

# ── Environment-specific build files ─────────────────────────────────────────
# .env.development  — local `vite dev` (leave VITE_API_URL unset for proxy)
# .env.production     — template for `vite build`; CI injects real VITE_* secrets

# ── Dev / test toggles (leave unset or false in production) ──────────────────

# Bypass auth guards in dev — ONLY works when MODE != production (enforced in code)
VITE_DEV_BYPASS_GUARDS=false

# Force login word CAPTCHA in dev (production builds enable it automatically).
# Pair with AUTH_LOGIN_WORD_CAPTCHA_REQUIRED=true on Java when testing captcha locally.
# VITE_LOGIN_CAPTCHA_REQUIRED=true

# ── Playwright E2E (not exposed to Vite bundle — set in shell or CI) ─────────
# Shared test profile (default: test@newcareer.com / Test@1234)
# E2E_TEST_EMAIL=test@newcareer.com
# E2E_TEST_PASSWORD=Test@1234
# E2E_BASE_URL=http://localhost:5173
# E2E_MIDDLEWARE_URL=http://localhost:4000

# ── Feature flags ─────────────────────────────────────────────────────────────

# Enable the experimental AI agent memory page
VITE_FEATURE_AGENT_MEMORY=false

# Enable auto-apply feature
VITE_FEATURE_AUTO_APPLY=false

# ── Analytics & monitoring (optional) ────────────────────────────────────────

# PostHog analytics project API key
# VITE_POSTHOG_KEY=phc_xxxx

# Sentry DSN for frontend error tracking
# VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
