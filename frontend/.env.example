# ─────────────────────────────────────────────────────────────────────────────
# CareerOps Frontend — copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# Only VITE_ prefixed vars are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# The frontend MUST talk to the Node middleware — never Java directly.
# Leave VITE_API_URL unset during `vite dev` to use the built-in `/api` proxy
# to the middleware on port 4000 without browser CORS preflights.
# Uncomment the next line for `vite preview` or any cross-origin frontend setup.
# VITE_API_URL=http://localhost:4000

# ── Dev / test toggles (leave unset or false in production) ──────────────────

# Bypass auth guards in dev — ONLY works when MODE != production (enforced in code)
VITE_DEV_BYPASS_GUARDS=false

# Use in-memory mock data instead of live API calls
VITE_USE_MOCKS=false

# ── Feature flags ─────────────────────────────────────────────────────────────

# Enable the experimental AI agent memory page
VITE_FEATURE_AGENT_MEMORY=false

# Enable auto-apply feature
VITE_FEATURE_AUTO_APPLY=false

# ── Analytics & monitoring (optional) ────────────────────────────────────────

# PostHog analytics project API key
# VITE_POSTHOG_KEY=phc_xxxx

# Sentry DSN for frontend error tracking
# VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
