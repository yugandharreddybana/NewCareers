{
  "name": "careerops-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stack": "concurrently -k -n vite,mw -c blue,green \"vite\" \"npm run dev --prefix ../middleware\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test auth --project=chromium",
    "test:e2e:auth:chrome": "playwright test auth-signup-login.spec.ts auth-login.spec.ts auth-route-guards.spec.ts --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:signup": "playwright test auth-signup-login.spec.ts --headed --project=chromium",
    "test:e2e:report": "playwright show-report ../playwright-report"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-oauth/google": "^0.12.2",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-query": "^5.100.9",
    "@testing-library/dom": "^10.4.1",
    "@types/react-google-recaptcha": "^2.1.9",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.27.0",
    "react-window": "^1.8.10",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-helmet-async": "^1.0.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "jsdom": "^24.1.0",
    "msw": "^2.14.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.1.0"
  }
}
