# CareerOps Node Middleware — copy to .env and fill in

PORT=4000
NODE_ENV=development

# Shared JWT secret (Java issues tokens, Node verifies them — SAME value both sides)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM

# Java backend (never exposed to browser)
JAVA_BACKEND_URL=http://localhost:8080

# Internal trust header — must match application.properties
INTERNAL_TRUST_HEADER=X-Internal-User-Id
INTERNAL_TRUST_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# CORS — must match Vite dev port
ALLOWED_ORIGIN=http://localhost:5173

# Cookie settings
COOKIE_NAME=co_session
COOKIE_SECURE=false        # set true in production (HTTPS)
COOKIE_SAMESITE=lax
