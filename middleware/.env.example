# ─────────────────────────────────────────────────────────────────────────────
# CareerOps Node Middleware — copy this file to .env and fill in values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# ── Required: application will refuse to start without these ─────────────────
# (enforced by startup validation added in Batch 3 — C2 fix)

# Base64-encoded SPKI public key used to verify RS256 tokens issued by Java.
JWT_PUBLIC_

# Java backend URL — never exposed to the browser
JAVA_BACKEND_URL=http://localhost:8080

# ── CORS — C1 fix: supports multiple origins (comma-separated) ───────────────
# ALLOWED_ORIGINS replaces the old single-value ALLOWED_ORIGIN.
# In dev: just localhost. In prod: add staging/preview URLs.
ALLOWED_ORIGINS=http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://app.careerops.io,https://staging.careerops.io

# ── Redis — for distributed rate limiting (A4 fix) ───────────────────────────
# Optional: if unset, rate limiters fall back to in-memory (single-instance only)
REDIS_URL=redis://localhost:6379

# ── Internal service trust ────────────────────────────────────────────────────
# Header + secret used when the Java backend calls Node directly.
# Must match application.properties on the Java side.
INTERNAL_TRUST_HEADER=X-Internal-User-Id
INTERNAL_TRUST_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ── Cookie settings ───────────────────────────────────────────────────────────
COOKIE_NAME=co_session
COOKIE_SECURE=false        # set true in production (requires HTTPS)
COOKIE_SAMESITE=lax

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Sentry DSN for backend error tracking
# SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
