# ─────────────────────────────────────────────────────────────────────────────
# CareerOps Middleware — copy to .env
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Must match the Java backend port for your active Spring profile:
#   test profile (default): http://localhost:8100
#   dev profile (Postgres): http://localhost:8080
JAVA_BACKEND_URL=http://localhost:8100

# Base64 SPKI public key — must match jwt.public-key in Java (test/dev properties)
JWT_PUBLIC_

# Must match internal.trust.secret in Java (application-test.properties / application-dev.properties)
INTERNAL_TRUST_HEADER=X-Internal-User-Id
INTERNAL_TRUST_SECRET=test-internal-trust-secret-minimum-32-characters-long

# Vite dev server origin
# Include 5174 — Vite uses the next free port when 5173 is taken
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

COOKIE_NAME=co_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional — distributed rate limiting (omit in local dev)
# REDIS_URL=redis://localhost:6379
