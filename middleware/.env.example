# ─────────────────────────────────────────────────────────────────────────────
# CareerOps Middleware — copy to .env
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Must match Java jobs.daily.cap (default 25) — caps POST /jobs/fetch?count=
JOBS_DAILY_CAP=25

# Opt-in fake user when no JWT (local API testing without login). Default: off.
# DEV_AUTO_AUTH=true

# Must match the Java backend port for your active Spring profile:
#   test profile (default): http://localhost:8100
#   dev profile (Postgres): http://localhost:8080
JAVA_BACKEND_URL=http://localhost:8080

# Base64 SPKI public key — must match Java jwt.public-key / JWT_PUBLIC_KEY_PEM (test/dev properties)
JWT_PUBLIC_
# Third-party JWKS (proxied from Java): GET http://localhost:4000/.well-known/jwks.json

# HMAC signing secret for middleware → Java (must match repo-root .env APP_INTERNAL_SECRET)
INTERNAL_TRUST_HEADER=X-Internal-User-Id
APP_INTERNAL_SECRET=
# Deprecated alias — will be removed; use APP_INTERNAL_SECRET only
# INTERNAL_TRUST_SECRET=

# Vite dev server origin
# Include 5174 — Vite uses the next free port when 5173 is taken
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

COOKIE_NAME=co_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional — distributed rate limiting (omit in local dev)
# REDIS_URL=redis://localhost:6379
