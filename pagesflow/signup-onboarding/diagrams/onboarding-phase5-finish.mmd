sequenceDiagram
    participant Onb as Onboarding.tsx
    participant Finish as completeOnboardingFinish
    participant AuthContext
    participant Axios
    participant Java

    Onb->>Finish: proceedFinish wizard state
    alt no cvFile
        Finish-->>Onb: missing_cv error
    else pending signup
        Finish->>AuthContext: signUp signupIntentId emailVerificationId
        AuthContext->>Java: POST /auth/register
        alt intent expired or decoy
            Java-->>Onb: 400 Sign-up session expired
        else no verificationId
            Java-->>Onb: 400 Email verification required
        else success
            Java-->>AuthContext: user + cookies
        end
    else existing Google user
        Finish->>AuthContext: ensureFreshSession
    end
    Finish->>Axios: PUT /profile onboarded true
    Finish->>Axios: POST /profile/cv
    Finish->>Axios: POST /profile/portfolio per project
    Finish->>Axios: POST /onboarding/delivery/start
    Finish->>Finish: clearPendingSignup clearOnboardingVerification
