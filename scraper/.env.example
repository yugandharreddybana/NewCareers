# ─────────────────────────────────────────────────────────────────────────────
# NewCareers Scraper Microservice — copy to .env and fill in values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────────────
# Supported: openai/gpt-4o-mini, openai/gpt-4o, groq/llama3-8b-8192,
#            ollama/llama3.2, azure/<deployment>, google/gemini-pro
SCRAPER_LLM_MODEL=openai/gpt-4o-mini

# API key for the LLM provider. Leave blank when using Ollama (local).
SCRAPER_LLM_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# ── Ollama (optional, only if SCRAPER_LLM_MODEL starts with ollama/) ─────────
# OLLAMA_BASE_URL=http://localhost:11434

# ── Service settings ─────────────────────────────────────────────────────────
SCRAPER_PORT=5500
SCRAPER_VERBOSE=false

# Comma-separated origins allowed to call this service
# Should match your middleware origin (e.g. http://localhost:4000)
SCRAPER_ALLOWED_ORIGINS=http://localhost:4000

# Disable ScrapeGraphAI anonymous telemetry
SCRAPEGRAPHAI_TELEMETRY_ENABLED=false
